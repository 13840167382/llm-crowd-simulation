# Only model-related overrides: merge into backend/.env.local after configuring
# database and Redis using backend/.env.local.example. This file is not auto-loaded.
# The served-model-name and API key must match the local vLLM server.
APP_ENV=local
APP_PORT=8987
APP_DECISION_ENGINE_MODE=openai_compatible
APP_DECISION_PROVIDER_BASE_URL=http://127.0.0.1:8001/v1
APP_DECISION_PROVIDER_API_KEY=REPLACE_WITH_YOUR_VLLM_API_KEY
APP_DECISION_PROVIDER_MODEL=qwen36-crowd
APP_DECISION_PROVIDER_TEMPERATURE=0
APP_DECISION_PROMPT_VERSION=v1
# Start with one concurrent call for integration checks; use recorded settings
# when reproducing a measured experiment.
APP_DECISION_BATCH_MAX_CONCURRENCY=1
APP_DECISION_BATCH_HARD_TIMEOUT_SECONDS=8
