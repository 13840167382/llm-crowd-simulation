# 生产环境配置模板；复制为 .env.production 后必须替换数据库、Redis 和模型服务密钥。

# 服务显示名称，会出现在 OpenAPI、根路径服务概览和日志中。
APP_NAME=人群流动模拟系统后端
# 当前运行环境名称；生产环境使用 production。
APP_ENV=production
# HTTP 服务监听地址；服务器或 Docker 容器通常使用 0.0.0.0。
APP_HOST=0.0.0.0
# HTTP 服务监听端口。
APP_PORT=8000
# 是否开启开发热重载；生产环境必须关闭。
APP_RELOAD=false
# 日志级别；生产环境通常使用 info。
APP_LOG_LEVEL=info
# 是否把日志写入文件；容器环境也可以改为 false 只输出 stdout。
APP_LOG_TO_FILE=true
# 日志目录；相对 backend 工作目录。
APP_LOG_DIR=logs
# 日志文件名；日志模块会按日期和大小轮转。
APP_LOG_FILENAME=backend.production.log
# 单个日志文件最大字节数，超过后触发轮转。
APP_LOG_MAX_BYTES=10485760
# 日志轮转保留文件数量；生产环境通常保留更多。
APP_LOG_BACKUP_COUNT=14

# 应用运行使用的 PostgreSQL/TimescaleDB 连接串；必须替换账号、密码、主机和库名。
APP_DATABASE_URL=postgresql+psycopg://app_user:请替换为生产密码@db.example.com:5432/crowd_flow_simulation
# Alembic 数据库迁移使用的连接串；通常与 APP_DATABASE_URL 一致，也可以使用更高权限迁移账号。
APP_ALEMBIC_DATABASE_URL=postgresql+psycopg://app_user:请替换为生产密码@db.example.com:5432/crowd_flow_simulation
# 是否打印 SQLAlchemy SQL 日志；生产建议关闭。
APP_DB_ECHO=false
# PostgreSQL 连接池常驻连接数；单个后端进程最多保留这些空闲连接。
APP_DB_POOL_SIZE=5
# PostgreSQL 连接池溢出连接数；高峰期可额外创建，空闲后释放。
APP_DB_MAX_OVERFLOW=10
# 获取 PostgreSQL 连接的最长等待时间，单位秒；超过后请求会失败。
APP_DB_POOL_TIMEOUT_SECONDS=30
# PostgreSQL 连接回收时间，单位秒；防止长连接被网络或数据库静默断开。
APP_DB_POOL_RECYCLE_SECONDS=1800
# 是否启用 Redis；生产建议启用，用于缓存、幂等锁、决策锁和 RQ worker。
APP_REDIS_ENABLED=true
# Redis 连接串；必须替换生产 Redis 主机和密码。
APP_REDIS_URL=redis://:请替换为生产密码@redis.example.com:6379/0
# Redis key 前缀，用于隔离不同环境或不同项目的数据。
APP_REDIS_KEY_PREFIX=crowd_flow_simulation
# Redis 连接和读写超时时间，单位秒。
APP_REDIS_SOCKET_TIMEOUT_SECONDS=1.0
# Redis 普通缓存/锁客户端的最大连接数。
APP_REDIS_MAX_CONNECTIONS=20
# Redis RQ 队列客户端的最大连接数；RQ 使用独立二进制连接池。
APP_REDIS_RQ_MAX_CONNECTIONS=20
# 热力图缓存 TTL，单位秒；小于等于 0 表示不写缓存。
APP_HEATMAP_CACHE_TTL_SECONDS=300
# 是否启用实验完成后的默认热力图预热任务。
APP_HEATMAP_PREWARM_ENABLED=true
# 热力图预热默认网格大小，单位与场景坐标一致。
APP_HEATMAP_PREWARM_CELL_SIZE=10.0
# 热力图预热时最多为多少个人群类型生成独立图层。
APP_HEATMAP_PREWARM_MAX_CROWD_TYPES=6
# 轨迹采样表的采样间隔，单位毫秒，用于 compact 轨迹查询。
APP_TRAJECTORY_QUERY_SAMPLE_INTERVAL_MS=1000
# 原始轨迹查询允许的最大时间窗口，单位毫秒，防止大范围扫表。
APP_TRAJECTORY_QUERY_MAX_RAW_WINDOW_MS=300000
# 原始轨迹查询允许的最大分页大小，防止单次响应过大。
APP_TRAJECTORY_QUERY_MAX_RAW_PAGE_SIZE=2000
# 出生点生成结果缓存 TTL，单位秒；同 seed 可复用缓存。
APP_SPAWN_POSITIONS_CACHE_TTL_SECONDS=3600
# 决策引擎模式；可用值包括 heuristic/mock/local/openai/openai_compatible/llm。
APP_DECISION_ENGINE_MODE=openai_compatible
# OpenAI-compatible 模型服务 base URL，不需要包含 /chat/completions。
APP_DECISION_PROVIDER_BASE_URL=https://api.openai.com/v1
# 模型服务 API Key；生产必须通过密钥管理或私有环境文件注入。
APP_DECISION_PROVIDER_API_KEY=请替换为真实模型服务密钥
# 全局模型名覆盖；为空时使用实验创建时传入的 llm_model。
APP_DECISION_PROVIDER_MODEL=
# 模型采样温度；决策任务通常建议 0 或较低值。
APP_DECISION_PROVIDER_TEMPERATURE=0
# 决策 Prompt 版本；当前代码支持 v1。
APP_DECISION_PROMPT_VERSION=v1
# 单个决策批次最大硬超时，单位秒；超过后剩余人物走 fallback/none。
APP_DECISION_BATCH_HARD_TIMEOUT_SECONDS=8
# 决策批次内调用模型的最大并发数；生产需要按模型服务吞吐能力调整。
APP_DECISION_BATCH_MAX_CONCURRENCY=4
# 同一实验同一 batch_id 的 Redis 批次锁 TTL，单位秒。
APP_DECISION_BATCH_LOCK_TTL_SECONDS=30
# 同一实验决策请求串行化 Redis 锁 TTL，单位秒。
APP_DECISION_EXPERIMENT_LOCK_TTL_SECONDS=30
# X-Request-Id 幂等响应快照保留时间，单位秒。
APP_REQUEST_IDEMPOTENCY_TTL_SECONDS=86400
# X-Request-Id 正在处理锁的 TTL，单位秒。
APP_REQUEST_IDEMPOTENCY_LOCK_TTL_SECONDS=30
# RQ 维护任务队列名称。
APP_MAINTENANCE_QUEUE_NAME=maintenance
# RQ 单个维护任务最大执行时间，单位秒。
APP_MAINTENANCE_RQ_JOB_TIMEOUT_SECONDS=1800
# RQ job 在队列中的最大存活时间，单位秒。
APP_MAINTENANCE_RQ_TTL_SECONDS=86400
# RQ 成功结果保留时间，单位秒。
APP_MAINTENANCE_RQ_RESULT_TTL_SECONDS=600
# RQ 失败结果保留时间，单位秒，便于生产排查失败原因。
APP_MAINTENANCE_RQ_FAILURE_TTL_SECONDS=604800
# 本地直接执行型维护 worker 空闲轮询间隔，单位秒。
APP_MAINTENANCE_WORKER_POLL_INTERVAL_SECONDS=5
# 本地维护 worker 连续空闲多少轮打印一次心跳日志。
APP_MAINTENANCE_WORKER_IDLE_LOG_EVERY_POLLS=12
# 维护任务失败后的最大重试次数。
APP_MAINTENANCE_JOB_MAX_RETRY_ATTEMPTS=3
# 维护任务失败后退避重试的基础间隔，单位秒。
APP_MAINTENANCE_JOB_RETRY_BACKOFF_SECONDS=30
# 实验完成后是否自动入队聚合刷新、热力图预热、清理和归档任务。
APP_EXPERIMENT_RUNTIME_CLEANUP_AUTO_ENQUEUE=true
